{
  "name": "@mardu/workspace",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:mardu-de": "bun --cwd apps/mardu-de run dev",
    "dev:platform": "bun --cwd apps/platform run dev",
    "payload": "cd apps/platform && bun run payload",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "clean": "turbo run clean",
    "build:analyze": "turbo run build:analyze"
  },
  "devDependencies": {
    "raw-loader": "^4.0.2",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@hono/node-server": "2.1.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "body-parser": "2.3.0",
    "dompurify": "3.4.13",
    "esbuild": "0.25.12",
    "fast-uri": "3.1.5",
    "flatted": "3.4.4",
    "happy-dom": "20.11.2",
    "hono": "4.13.1",
    "immutable": "5.1.9",
    "ip-address": "10.4.0",
    "js-yaml": "4.3.1",
    "lodash": "4.18.1",
    "mcp-handler": "1.1.0",
    "path-to-regexp": "8.4.2",
    "picomatch": "2.3.2",
    "qs": "6.15.3",
    "ws": "8.21.3",
    "yaml": "1.10.3"
  }
}
