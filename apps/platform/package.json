{
  "name": "@mardu/app-platform",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev --webpack -p 4000",
    "build": "next build --turbopack",
    "start": "next start",
    "payload": "cross-env PAYLOAD_CONFIG_PATH=payload.config.ts payload",
    "lint": "eslint .",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "clean": "rm -rf .next",
    "generate:types": "bun run payload generate:types",
    "generate:importmap": "bun run payload generate:importmap",
    "admin:reset-password": "bun scripts/reset-admin-password.mjs",
    "payload:migrate": "bun run payload migrate",
    "payload:migrate:status": "bun run payload migrate:status",
    "payload:migrate:create": "bun run payload migrate:create",
    "payload:migrate:fresh": "bun run payload migrate:fresh",
    "build:analyze": "ANALYZE=true next build --webpack",
    "seed:catalog": "bun scripts/seed-catalog.mjs",
    "seed:integrations": "bun scripts/seed-integrations.mjs",
    "seed:legal-pages": "bun scripts/seed-legal-pages.mjs",
    "seed:roadmap-items": "bun scripts/seed-roadmap-items.mjs",
    "seed:solutions": "bun scripts/seed-solutions.mjs",
    "seed:all": "bun scripts/seed-all.mjs",
    "release:content:audit": "bun scripts/audit-release-content.mjs",
    "images:compress:overwrite": "bun scripts/compress-images.mjs --overwrite",
    "api:twenty:pull-openapi": "bun scripts/fetch-twenty-openapi.mjs",
    "api:twenty:generate": "npm run api:twenty:pull-openapi && orval --config orval.config.cjs && node scripts/mark-generated-twenty-no-check.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@mardu/content-core": "workspace:*",
    "@mardu/layout": "workspace:*",
    "@mardu/lead-core": "workspace:*",
    "@mardu/sections": "workspace:*",
    "@mardu/site-config": "workspace:*",
    "@mardu/styles": "workspace:*",
    "@mardu/ui": "workspace:*",
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/plugin-mcp": "3.88.0",
    "@payloadcms/plugin-seo": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "drizzle-kit": "0.31.10",
    "@stepperize/react": "^5.1.9",
    "@tailwindcss/typography": "^0.5.20",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "jose": "^6.2.8",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "payload": "3.88.0",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "3.10.1",
    "resend": "^6.19.0",
    "simplex-noise": "^4.0.3",
    "sonner": "^2.0.8",
    "tailwind-clip-path": "^1.0.0",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@mardu/eslint-config": "workspace:*",
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "orval": "8.24.0",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "sharp": "^0.35.3",
    "svgo": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "unrs-resolver"
  ]
}
