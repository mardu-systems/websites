    "@types/node": "^26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "orval": "8.23.0",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "sharp": "^0.35.3",
    "svgo": "^4.0.2",
