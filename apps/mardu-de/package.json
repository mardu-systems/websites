{
  "name": "@mardu/app-mardu-de",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "clean": "rm -rf .next",
    "build:analyze": "ANALYZE=true next build",
    "images:compress:overwrite": "node scripts/compress-images.mjs --overwrite",
    "api:twenty:pull-openapi": "node scripts/fetch-twenty-openapi.mjs",
