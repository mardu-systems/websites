    "framer-motion": "^13.0.0",
    "input-otp": "^1.4.2",
    "jose": "^6.2.8",
    "lucide-react": "^0.562.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "photoswipe": "^5.4.4",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.84.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "3.10.1",
