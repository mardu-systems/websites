# Public frontend origin (Payload-Content-API läuft in derselben App unter /api)
APP_URL=http://localhost:3000

# Optional timeout for Payload content requests in milliseconds (1000-30000)
PAYLOAD_FETCH_TIMEOUT_MS=10000

# Feature flags (PostHog EU-Cloud; ohne Key gelten die statischen Defaults/Fallbacks)
POSTHOG_API_KEY=
# Optional, Standard https://app-eu.posthog.com
POSTHOG_HOST=
# Statische Fallbacks pro Flag (überschreiben PostHog): true/false oder leer
MARDU_DE_ENABLE_BLOG=
MARDU_DE_ENABLE_INTEGRATIONS=
MARDU_DE_ENABLE_PRODUCTS=

# Lead / email
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TO=
NEWSLETTER_SECRET=

# Google reCAPTCHA (in development, missing keys intentionally disable captcha)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Optional Twenty CRM
TWENTY_API_KEY=
TWENTY_API_BASE_URL=https://twenty.mardu.systems/rest
TWENTY_SYNC_TIMEOUT_MS=6000
TWENTY_CONTACT_MESSAGE_FIELD=
TWENTY_CONTACT_SOURCE_FIELD=
TWENTY_CONTACT_NEWSLETTER_OPT_IN_FIELD=
TWENTY_CONTACT_SITE_FIELD=
TWENTY_CONTACT_CONSENT_FIELD=
TWENTY_NEWSLETTER_STATUS_FIELD=
TWENTY_NEWSLETTER_ROLE_FIELD=
TWENTY_NEWSLETTER_CONSENT_MODEL_FIELD=

# Payload CMS (Admin unter /admin, API unter /api)
DATABASE_URI=
PAYLOAD_SECRET=
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Required on Vercel; optional locally to keep using apps/mardu-de/media
BLOB_READ_WRITE_TOKEN=

# Payload OIDC SSO
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/sso/callback
OIDC_ALLOWED_EMAILS=
OIDC_ALLOWED_EMAIL_DOMAINS=
OIDC_AUTO_CREATE_USERS=false
OIDC_SESSION_SECRET=
OIDC_DEBUG=false

# GlitchTip: public project DSN; empty disables reporting (see docs/error-tracking.md)
NEXT_PUBLIC_GLITCHTIP_DSN=
# Optional server-only DSN override
GLITCHTIP_DSN=
NEXT_PUBLIC_GLITCHTIP_ENVIRONMENT=development
NEXT_PUBLIC_GLITCHTIP_RELEASE=
# Optional build-time source map upload; auth token must never be public
GLITCHTIP_URL=
GLITCHTIP_ORG=
GLITCHTIP_PROJECT=
GLITCHTIP_AUTH_TOKEN=
